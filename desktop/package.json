{
  "name": "rupee-rush-desktop",
  "productName": "Rupee Rush",
  "version": "0.1.0",
  "description": "Offline Rupee Rush for Windows and Linux; shares the Android game's web assets.",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable --x64 --publish never",
    "dist:linux": "electron-builder --linux AppImage deb --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "io.github.mrcalzon02.rupeerush.desktop",
    "productName": "Rupee Rush",
    "directories": {
      "output": "../release-desktop"
    },
    "files": [
      "main.js",
      "preload.js",
      "asset-routing.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web",
        "to": "game",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "artifactName": "RupeeRush-Windows-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "RupeeRush-Windows-Portable-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Game",
      "desktop": {
        "entry": {
          "Name": "Rupee Rush",
          "Comment": "Offline gem-match, mining and town game"
        }
      }
    },
    "appImage": {
      "artifactName": "RupeeRush-Linux-${version}-${arch}.AppImage"
    },
    "deb": {
      "artifactName": "RupeeRush-Linux-${version}-${arch}.deb"
    }
  }
}
